{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/overlay/**",
              "ui_kits/creator-studio/**",
              "ui_kits/dap-widget/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Roboto Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, Roboto Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|content|icon|key|ref|className|style|children)$/]",
        "message": "<AccordionItem> doesn't accept that prop. Declared props: title, content, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertModal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|intent|title|children|confirmLabel|cancelLabel|onConfirm|onCancel|style|key|ref|className|style|children)$/]",
        "message": "<AlertModal> doesn't accept that prop. Declared props: open, intent, title, children, confirmLabel, cancelLabel, onConfirm, onCancel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertModal'] > JSXAttribute[name.name='intent'] > Literal[value!=/^(?:critical|warning|success|info)$/]",
        "message": "<AlertModal> intent must be one of 'critical' | 'warning' | 'success' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertPictogram'] > JSXAttribute > JSXIdentifier[name!=/^(?:intent|size|icon|style|key|ref|className|style|children)$/]",
        "message": "<AlertPictogram> doesn't accept that prop. Declared props: intent, size, icon, style."
